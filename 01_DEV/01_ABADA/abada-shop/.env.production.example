# ============================================================
# abada-shop Production Environment Variables
# ============================================================
# Copy to .env.production and fill in REAL values
# NEVER commit .env.production to Git
# ============================================================

# ----- Database (PostgreSQL) -----
POSTGRES_USER=abada
POSTGRES_PASSWORD=<strong-password>
POSTGRES_DB=abada_shop
DATABASE_URL=postgresql://abada:<strong-password>@postgres:5432/abada_shop?schema=public

# ----- Redis -----
REDIS_PASSWORD=<strong-redis-password>
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ----- JWT Authentication -----
JWT_SECRET=<long-random-secret-min-64-chars>
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<long-random-refresh-secret-min-64-chars>
JWT_REFRESH_EXPIRES_IN=7d

# ----- TossPayments -----
TOSS_SECRET_KEY=live_sk_xxxxxxxxxxxxxxxxxxxx
TOSS_API_BASE_URL=https://api.tosspayments.com/v1
NEXT_PUBLIC_TOSS_CLIENT_KEY=live_ck_xxxxxxxxxxxxxxxxxxxx

# ----- App -----
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=warn
CORS_ORIGIN=https://shop.abada.kr

# ----- Frontend Public Variables -----
NEXT_PUBLIC_API_URL=https://api.shop.abada.kr
NEXT_PUBLIC_SITE_URL=https://shop.abada.kr

# ----- Cloudflare R2 (File Storage) -----
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=abada-shop
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev
R2_ENDPOINT=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# ----- Admin -----
ADMIN_WEBHOOK_SECRET=<your-webhook-secret>

# ----- Optional: Email (SMTP) -----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=noreply@abada.kr

# ----- Optional: Slack Webhook -----
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ----- Optional: Sentry -----
# SENTRY_DSN=https://xxx@sentry.io/xxx
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
